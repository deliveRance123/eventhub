# Neon Cloud Database (PostgreSQL)
# Copy your connection string from the Neon Console:
# Example: postgresql://neondb_owner:npg_xyz@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Server Configuration
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=your-secure-jwt-secret-key-change-in-production

# Default Admin Account (Seeded on first launch)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!
